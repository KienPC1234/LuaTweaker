{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "request": "launch",
      "name": "Run Client (NeoForge)",
      "projectName": "neoforge-platform",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/neoforge-platform/build/moddev/clientRunProgramArgs.txt"
      ],
      "vmArgs": [
        "@${workspaceFolder}/neoforge-platform/build/moddev/clientRunVmArgs.txt",
        "-Dfml.modFolders=luatweaker%%${workspaceFolder}/neoforge-platform/build/resources/main"
      ],
      "cwd": "${workspaceFolder}/run",
      "console": "internalConsole",
      "shortenCommandLine": "argFile",
      "preLaunchTask": "gradle: build"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "Run Server (NeoForge)",
      "projectName": "neoforge-platform",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/neoforge-platform/build/moddev/serverRunProgramArgs.txt"
      ],
      "vmArgs": [
        "@${workspaceFolder}/neoforge-platform/build/moddev/serverRunVmArgs.txt",
        "-Dfml.modFolders=luatweaker%%${workspaceFolder}/neoforge-platform/build/resources/main"
      ],
      "cwd": "${workspaceFolder}/run",
      "console": "internalConsole",
      "shortenCommandLine": "argFile",
      "preLaunchTask": "gradle: prepareServerRun"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "neoforge-platform - Client",
      "presentation": {
        "group": "Mod Development - neoforge-platform",
        "order": 0
      },
      "projectName": "neoforge-platform",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/neoforge-platform/build/moddev/clientRunProgramArgs.txt"
      ],
      "vmArgs": [
        "@${workspaceFolder}/neoforge-platform/build/moddev/clientRunVmArgs.txt",
        "-Dfml.modFolders=luatweaker%%${workspaceFolder}/neoforge-platform/build/resources/main"
      ],
      "cwd": "${workspaceFolder}/run",
      "env": {},
      "console": "internalConsole",
      "shortenCommandLine": "argFile"
    },
    {
      "type": "java",
      "request": "launch",
      "name": "neoforge-platform - Server",
      "presentation": {
        "group": "Mod Development - neoforge-platform",
        "order": 1
      },
      "projectName": "neoforge-platform",
      "mainClass": "net.neoforged.devlaunch.Main",
      "args": [
        "@${workspaceFolder}/neoforge-platform/build/moddev/serverRunProgramArgs.txt"
      ],
      "vmArgs": [
        "@${workspaceFolder}/neoforge-platform/build/moddev/serverRunVmArgs.txt",
        "-Dfml.modFolders=luatweaker%%${workspaceFolder}/neoforge-platform/build/resources/main"
      ],
      "cwd": "${workspaceFolder}/run",
      "env": {},
      "console": "internalConsole",
      "shortenCommandLine": "argFile"
    }
  ]
}